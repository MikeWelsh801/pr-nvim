#!/usr/bin/env bash
# Stub `gh` for tests: answers the exact calls the plugin makes.
F="${PR_REVIEW_FIXTURES:?}"
case "$1 $2" in
  "pr view") cat "$F/pr.json" ;;
  "api "*)
    shift
    args=("$@")
    if [[ "${args[*]}" == *"compare/"* ]]; then echo "ba5e000000000000000000000000000000000000"; exit 0; fi
    if [[ "${args[*]}" == *"/files?"* ]]; then cat "$F/files.json"; exit 0; fi
    if [[ "${args[*]}" == *"/contents/"* ]]; then
      path=$(printf '%s\n' "${args[@]}" | grep '/contents/' | sed -E 's#.*/contents/([^?]*)\?ref=([a-z0-9]+)#\1 \2#')
      p=${path% *}; ref=${path#* }
      cat "$F/content_${ref:0:4}_$(echo "$p" | tr '/' '_')"; exit $?
    fi
    if [[ "${args[*]}" == *"-X POST"* ]]; then cat > "${PR_REVIEW_POST_OUT:?}"; echo '{"html_url":"https://github.com/acme/widgets/pull/7#pullrequestreview-1"}'; exit 0; fi
    echo "unhandled api: ${args[*]}" >&2; exit 1 ;;
  *) echo "unhandled: $*" >&2; exit 1 ;;
esac
